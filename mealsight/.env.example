MISTRAL_API_KEY
GROQ_API_KEY
OPENWEATHER_API_KEY
ROBOFLOW_API_KEY

# Default location for the weather signal in get_context_signals — there is
# no login and no stored user location anywhere in this system, so this is
# the single configured location every request uses. Defaults to Raleigh,
# NC (see mealsight.config.settings); override both per deployment to move
# the default location elsewhere (e.g. a different single-tenant install).
DEFAULT_WEATHER_LAT=35.7796
DEFAULT_WEATHER_LON=-78.6382