# API base URL the frontend talks to.
#
# Left empty (or unset) for local dev: src/api/client.ts then uses
# relative paths ("/api/...", "/ws/..."), which vite.config.ts's own
# dev-server proxy forwards to the real backend (VITE_BACKEND_ORIGIN,
# default http://localhost:8000) — no CORS involved at all locally.
#
# Set this to a real deployed backend origin (e.g.
# https://api.mealsight.example.com) for a production build, where
# there is no dev-server proxy to rely on.
VITE_API_BASE_URL=

# Where the LOCAL DEV PROXY forwards /api, /health, and /ws to. Only
# read by vite.config.ts itself, never bundled into the built app.
VITE_BACKEND_ORIGIN=http://localhost:8000
